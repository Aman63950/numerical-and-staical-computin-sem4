#include <stdio.h>
#include <math.h>

float f(float x) {
    return x*x*x - x - 2;
}

float df(float x) {
    return 3*x*x - 1;
}

int main() {
    float x = 1.5;
    int i;

    for(i=1; i<=10; i++) {
        x = x - f(x)/df(x);
        printf("Iteration %d: Root = %f\n", i, x);
    }
    return 0;
}
